---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../utils/translations';

const locale = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale);
---

<BaseLayout title={t('nav.about')} description="Espacio expositivo de la Cátedra Lacabanne (UNA) - Artes Multimediales">
  <div class="about-container">
    <header class="about-header">
      <h1 class="about-title">{t('nav.about')}</h1>
      <p class="about-subtitle">Artes Multimediales 1 y 4 — Cátedra Lacabanne</p>
    </header>

    <div class="about-content-grid">
      <!-- Main Text Block -->
      <section class="info-section glass-panel">
        <h2>El proyecto</h2>
        <p>
          Este dispositivo de exhibición permanente (24/7) pone en circulación la pulsión creativa de los estudiantes durante la cursada de la asignatura <strong>Artes Multimediales 1 (cátedra Lacabanne)</strong>, perteneciente a la <em>Licenciatura en Artes Multimediales</em> del <em>Departamento de Artes Multimediales y Electrónicas</em> de la UNA (Ciudad Autónoma de Buenos Aires, Argentina).
        </p>
        <p>
          Lejos de ser un mero repositorio, la galería funciona como una membrana donde el código toma cuerpo y se expresa. <code>&lt;la-piscine&gt;</code> documenta y expone el recorrido poético y especulativo de los alumnos a través de la escritura creativa en p5.js, forzando un campo de contacto íntimo entre la lógica computacional, la estampa estética y el espesor de la reflexión teórica.
        </p>
        <p>
          El sitio que hoy navegás es la tercera mutación del proyecto. Luego de abandonar su configuración inicial —la plantilla porfolio de <a href="https://github.com/benjaminhabert" target="_blank" rel="noopener noreferrer">Benjamin Habert</a> basada en Ruby/Jekyll—, el proyecto adquiere una nueva corporalidad técnica: una infraestructura sostenida por un stack nativo en JavaScript, diseñada para alojar la urgencia y el movimiento continuo de estas exploraciones situadas entre la lógica proposicional clásica y las cadencias fallidas del deseo.
        </p>
        
        <div class="channel-callout">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="youtube-icon"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
          <p>Los invitamos a visitar también nuestro canal oficial de <a href="https://www.youtube.com/@knnv" target="_blank" rel="noopener noreferrer">YouTube</a> para ver defensas de proyectos y tutoriales de la cátedra.</p>
        </div>
      </section>

      <!-- Faculty Sidebar -->
      <aside class="team-section glass-panel">
        <h2>Equipo Docente</h2>
        <div class="team-list">
          <div class="team-member">
            <div class="member-role">Profesor Titular Ordinario</div>
            <div class="member-name">Raúl Federico Lacabanne</div>
            <p class="member-bio">Profesor Titular Ordinario en el Área Transdepartamental de Artes Multimediales de la UNA. Profesor Adjunto Ordinario en la Universidad Nacional de Quilmes (UNQ).</p>
          </div>
          
          <div class="team-member">
            <div class="member-role">Profesor Adjunto Ordinario</div>
            <div class="member-name">Mauricio Gutiérrez</div>
          </div>
          
          <div class="team-member">
            <div class="member-role">Jefa de Trabajos Prácticos</div>
            <div class="member-name">Mirna Barreiro</div>
          </div>
          
          <div class="team-member">
            <div class="member-role">Ayudante de Segunda</div>
            <div class="member-name">Candela Corradin Tessa</div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .about-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .about-title {
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, var(--text-primary) 40%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: var(--theme-transition);
  }

  .about-subtitle {
    font-size: 1.15rem;
    color: var(--accent-purple);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: var(--theme-transition);
  }

  .about-content-grid {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 2.5rem;
    align-items: start;
  }

  .glass-panel {
    background: rgba(12, 18, 30, 0.45);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: var(--transition-smooth), var(--theme-transition);
  }

  html[data-theme="light"] .glass-panel {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .glass-panel h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.75rem;
    transition: var(--theme-transition);
  }

  html[data-theme="light"] .glass-panel h2 {
    border-bottom: 1px solid rgba(15, 23, 42, 0.05);
  }

  .info-section {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--text-secondary);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: var(--theme-transition);
  }

  .info-section strong {
    color: var(--text-primary);
    transition: var(--theme-transition);
  }

  .info-section a {
    color: var(--accent);
    border-bottom: 1px dashed var(--accent);
    transition: var(--transition-smooth), var(--theme-transition);
  }

  .info-section a:hover {
    color: var(--text-primary);
    border-bottom-style: solid;
  }

  .channel-callout {
    margin-top: 1rem;
    background: rgba(6, 182, 212, 0.04);
    border: 1px solid rgba(6, 182, 212, 0.15);
    padding: 1.25rem;
    border-radius: 10px;
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    transition: var(--transition-smooth), var(--theme-transition);
  }

  html[data-theme="light"] .channel-callout {
    background: rgba(2, 132, 199, 0.04);
    border: 1px solid rgba(2, 132, 199, 0.15);
  }

  .youtube-icon {
    color: #ef4444;
    flex-shrink: 0;
    margin-top: 0.2rem;
    filter: drop-shadow(0 0 8px rgba(239, 68, 68, 0.3));
  }

  .channel-callout p {
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }

  /* Team sidebar style */
  .team-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .team-member {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .member-role {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--accent);
    letter-spacing: 0.05em;
    transition: var(--theme-transition);
  }

  .member-name {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    transition: var(--theme-transition);
  }

  .member-bio {
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin-top: 0.35rem;
    transition: var(--theme-transition);
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .about-content-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    
    .glass-panel {
      padding: 1.75rem;
    }
  }
</style>
