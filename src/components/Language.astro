---
import type { Locale } from '../utils/translations';

interface Props {
  code: Locale;
}

const { code } = Astro.props;
const currentLocale = (Astro.currentLocale || 'es') as Locale;
const hasEnglish = Astro.locals.hasEnglish;

let shouldRender = false;
if (currentLocale === 'es') {
  shouldRender = (code === 'es');
} else if (currentLocale === 'en') {
  if (hasEnglish) {
    shouldRender = (code === 'en');
  } else {
    // Graceful fallback: show Spanish content if English is not available
    shouldRender = (code === 'es');
  }
}
---

{shouldRender && <slot />}
