---
import { useTranslations, type Locale } from '../utils/translations';

const locale = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale);
const base = '/la-piscine';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-content">
    <div class="footer-info">
      <h3 class="footer-title">
        <span class="bracket">&lt;</span><span class="footer-logo-text">la-piscine</span><span class="bracket">&gt;</span>
      </h3>
      <p class="footer-description">{t('home.subtitle')}</p>
      <p class="footer-chair">{t('site.description')}</p>
    </div>
    
    <div class="footer-links">
      <div class="social-links">
        <a href="https://github.com/knnv-ar" target="_blank" rel="noopener noreferrer" class="social-link glass-panel" title="GitHub knnv">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
        </a>
        <a href="https://www.youtube.com/@knnv" target="_blank" rel="noopener noreferrer" class="social-link glass-panel" title="YouTube UNA">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
        </a>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container bottom-container">
      <p class="copyleft">&copy; 2020-{year} Artes Multimediales 1, cátedra Lacabanne. Copyleft - Material libre con fines educativos.</p>
      <p class="created-by">
        {locale === 'es' ? (
          <>Hecho con ❤️ por <a href="https://knnv-ar.github.io/resume/" target="_blank" rel="noopener noreferrer">Raúl Federico Lacabanne</a></>
        ) : (
          <>Made with ❤️ by <a href="https://knnv-ar.github.io/resume/" target="_blank" rel="noopener noreferrer">Raúl Federico Lacabanne</a></>
        )}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--glass-border);
    padding: 3rem 0 1.5rem 0;
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-top: auto;
    transition: var(--theme-transition);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .footer-info {
    flex: 1;
    min-width: 280px;
    max-width: 600px;
  }

  .footer-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    transition: var(--theme-transition);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    cursor: default;
  }

  .footer-title .bracket {
    color: var(--accent);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), color 0.3s ease, text-shadow 0.3s ease;
    display: inline-block;
  }

  .footer-title:hover .bracket:first-child {
    transform: translateX(-3px);
    color: var(--accent-purple);
    text-shadow: 0 0 10px var(--accent-purple-glow);
  }

  .footer-title:hover .bracket:last-child {
    transform: translateX(3px);
    color: var(--accent-purple);
    text-shadow: 0 0 10px var(--accent-purple-glow);
  }

  .footer-logo-text {
    background: linear-gradient(135deg, var(--text-primary) 30%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: filter 0.3s ease;
  }

  .footer-title:hover .footer-logo-text {
    filter: drop-shadow(0 0 8px var(--accent-glow));
  }

  .footer-description {
    font-size: 0.95rem;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    transition: var(--theme-transition);
  }

  .footer-chair {
    font-size: 0.8rem;
    color: var(--text-muted);
    transition: var(--theme-transition);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1rem;
    min-width: 200px;
  }

  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    transition: var(--transition-smooth), var(--theme-transition);
  }

  :global(html[data-theme="light"]) .social-link {
    background: rgba(15, 23, 42, 0.03);
  }

  .social-link:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }


  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.03);
    padding-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    transition: var(--theme-transition);
  }

  :global(html[data-theme="light"]) .footer-bottom {
    border-top: 1px solid rgba(15, 23, 42, 0.04);
  }

  .bottom-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .copyleft {
    letter-spacing: 0.01em;
  }

  .created-by {
    letter-spacing: 0.01em;
  }

  .created-by a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    transition: var(--transition-smooth), var(--theme-transition);
  }

  .created-by a:hover {
    color: var(--accent);
    text-decoration: underline;
  }


  /* Responsive Design */
  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    
    .footer-links {
      align-items: center;
    }
    
    .bottom-container {
      flex-direction: column;
      text-align: center;
      gap: 0.5rem;
    }
  }
</style>
