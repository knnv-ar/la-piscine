---
import { useTranslations, type Locale } from '../utils/translations';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { slug } = project;
const { title, author, year, semester, thumbnail } = project.data;

const locale = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale);
const base = '/la-piscine';

// URL for the project page (locale-correct)
const projectUrl = `${base}/${locale === 'en' ? 'en/' : ''}projects/${slug}/`.replace(/\/+/g, '/');

// Dynamic path to the synchronized thumbnail image
const thumbnailSrc = `${base}/projects/${slug}/${thumbnail || 'thumbnail.png'}`;
---

<a href={projectUrl} class="project-card-link">
  <article class="project-card glass-panel">
    <div class="card-thumbnail-container">
      <img 
        src={thumbnailSrc} 
        alt={title} 
        loading="lazy" 
        class="card-thumbnail"
        onerror="this.src='/la-piscine/assets/default_thumbnail.png'; this.onerror=null;"
      />

      <div class="thumbnail-overlay">
        <span class="overlay-action">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </span>
      </div>
    </div>
    
    <div class="card-details">
      <span class="card-meta">
        {year && <span class="card-year">{year}</span>}
        {semester && (
          <span class="card-semester-badge">
            {semester === 'first' ? '1º' : '2º'} Sem
          </span>
        )}
      </span>
      <h3 class="card-title">{title}</h3>
      <p class="card-author">{author}</p>
    </div>
  </article>
</a>

<style>
  .project-card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .project-card {
    background: rgba(12, 18, 30, 0.4);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transform: translateZ(0); /* Hardware acceleration */
  }

  .card-thumbnail-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #04060b;
  }

  .card-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .thumbnail-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 8, 14, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: var(--transition-smooth);
  }

  .overlay-action {
    color: var(--accent);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--glass-border-hover);
    padding: 0.8rem;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    transform: scale(0.8);
    transition: var(--transition-smooth);
    box-shadow: 0 0 15px var(--accent-glow);
  }

  .card-details {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex-grow: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.03);
    background: linear-gradient(180deg, rgba(12, 18, 30, 0.3) 0%, rgba(5, 8, 14, 0.5) 100%);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .card-semester-badge {
    background: rgba(139, 92, 246, 0.1);
    color: var(--accent-purple);
    border: 1px solid rgba(139, 92, 246, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .card-title {
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: var(--transition-smooth);
  }

  .card-author {
    font-size: 0.85rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Hover Animations */
  .project-card-link:hover .project-card {
    border-color: var(--glass-border-hover);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px var(--accent-glow);
    transform: translateY(-2px);
  }

  .project-card-link:hover .card-thumbnail {
    transform: scale(1.05);
  }

  .project-card-link:hover .thumbnail-overlay {
    opacity: 1;
  }

  .project-card-link:hover .overlay-action {
    transform: scale(1);
    background: rgba(6, 182, 212, 0.1);
  }

  .project-card-link:hover .card-title {
    color: var(--accent);
  }
</style>
