---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, type Locale } from '../utils/translations';
import { getDependencyTags } from '../utils/dependencies';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'projects'>;
}

const { entry } = Astro.props;
const { slug } = entry;
const { title, author, year, semester, dependencies, date } = entry.data;

const locale = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale);
const base = '/la-piscine';

// Resolve dependencies to script/link tags
const dependencyTags = getDependencyTags(dependencies);

// Format date nicely if available
const formattedDate = date ? new Date(date).toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}) : null;
---

<BaseLayout title={title} description={`${title} - ${t('project.author')}: ${author}`}>
  <!-- Inject <base> tag to force all relative student assets (images, sounds, sketch.js) 
       to resolve correctly from the canonical project folder path, regardless of locale routes -->
  <Fragment slot="head">
    <base href={`${base}/projects/${slug}/`} />
    <!-- Dynamic external dependencies tags -->
    <Fragment set:html={dependencyTags} />
  </Fragment>

  <div class="project-view-container">
    <!-- Breadcrumb back link -->
    <div class="breadcrumb-container">
      <a href={`${base}/${locale === 'en' ? 'en/' : ''}`} class="back-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        {t('archive.back')}
      </a>
    </div>

    <div class="project-layout-grid">
      <!-- LEFT COLUMN: p5.js Sketch viewport & interactive controls -->
      <div class="sketch-column">
        <div class="sketch-viewport-container glass-panel" id="sketch-viewport">
          <!-- The p5 canvas will render inside #div-sketch, standard container -->
          <div class="sketch-canvas-wrapper">
            <slot name="sketch" />
          </div>

          <!-- Controls bar -->
          <div class="sketch-controls">
            <button id="btn-restart" class="control-btn" title={t('project.restart')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="control-icon"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
              <span>{t('project.restart')}</span>
            </button>
            <button id="btn-fullscreen" class="control-btn" title={t('project.fullScreen')}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="control-icon"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
              <span>{t('project.fullScreen')}</span>
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Statement and Metadata -->
      <div class="statement-column">
        <article class="statement-card glass-panel">
          <header class="statement-header">
            <span class="meta-label">{t('project.credits')}</span>
            <h1 class="project-title">{title}</h1>
            
            <div class="artist-block">
              <span class="artist-label">{t('project.author')}:</span>
              <span class="artist-name">{author}</span>
            </div>
            
            <div class="metadata-grid">
              {year && (
                <div class="meta-item">
                  <span class="meta-title">{t('project.year')}</span>
                  <span class="meta-value">{year}</span>
                </div>
              )}
              {semester && (
                <div class="meta-item">
                  <span class="meta-title">{t('project.semester')}</span>
                  <span class="meta-value">{semester === 'first' ? t('project.first') : t('project.second')}</span>
                </div>
              )}
              {formattedDate && (
                <div class="meta-item">
                  <span class="meta-title">Fecha</span>
                  <span class="meta-value">{formattedDate}</span>
                </div>
              )}
            </div>
          </header>

          <hr class="divider" />

          <!-- Main content / statement text -->
          <div class="markdown-content">
            <slot name="content" />
          </div>
        </article>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Move student's #div-sketch container into the left-column viewport wrapper
  const divSketch = document.getElementById('div-sketch');
  const canvasWrapper = document.querySelector('.sketch-canvas-wrapper');
  if (divSketch && canvasWrapper) {
    canvasWrapper.appendChild(divSketch);
  }

  // Setup Fullscreen and Restart triggers
  const btnRestart = document.getElementById('btn-restart');
  const btnFullScreen = document.getElementById('btn-fullscreen');
  const sketchViewport = document.getElementById('sketch-viewport');

  if (btnRestart) {
    btnRestart.addEventListener('click', () => {
      // Simplest & most robust way to restart complex p5 projects (clears sounds, canvases, global loops)
      window.location.reload();
    });
  }

  if (btnFullScreen && sketchViewport) {
    btnFullScreen.addEventListener('click', () => {
      if (!document.fullscreenElement) {
        sketchViewport.requestFullscreen().then(() => {
          sketchViewport.classList.add('is-fullscreen');
        }).catch(err => {
          console.error(`Error enabling full-screen: ${err.message}`);
        });
      } else {
        document.exitFullscreen();
      }
    });

    // Listen to exit fullscreen via ESC key to clean classes
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement) {
        sketchViewport.classList.remove('is-fullscreen');
      }
    });
  }
</script>

<style is:global>
  /* Target student canvas elements to scale beautifully within the glass container */
  #div-sketch {
    width: 100% !important;
    height: 100% !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    background: transparent !important;
    margin: 0 auto !important;
  }

  #div-sketch canvas {
    max-width: 100% !important;
    max-height: 100% !important;
    width: auto !important;
    height: auto !important;
    aspect-ratio: auto !important;
    object-fit: contain !important;
    border-radius: 6px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
</style>

<style>
  .project-view-container {
    max-width: 1300px;
    margin: 0 auto;
    width: 100%;
    padding: 1.5rem 1.5rem 3rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .breadcrumb-container {
    display: flex;
    align-items: center;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .back-link:hover {
    color: var(--accent);
    transform: translateX(-4px);
  }

  .arrow-icon {
    transition: var(--transition-smooth);
  }

  .project-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: start;
    flex: 1;
  }

  /* Left Column: Sketch viewport styles */
  .sketch-column {
    position: sticky;
    top: calc(75px + 1rem); /* below header */
  }

  .sketch-viewport-container {
    background: rgba(8, 12, 21, 0.6);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    aspect-ratio: 1 / 1;
    max-height: calc(100vh - 150px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    position: relative;
    overflow: hidden;
    transition: var(--transition-smooth), var(--theme-transition);
  }

  html[data-theme="light"] .sketch-viewport-container {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04);
  }

  .sketch-viewport-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-purple));
  }

  .sketch-canvas-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  .sketch-controls {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 1rem;
    transition: var(--theme-transition);
  }

  html[data-theme="light"] .sketch-controls {
    border-top: 1px solid rgba(15, 23, 42, 0.05);
  }

  .control-btn {
    background: rgba(19, 27, 44, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: var(--text-secondary);
    padding: 0.5rem 1.2rem;
    border-radius: 30px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: var(--transition-smooth), var(--theme-transition);
  }

  html[data-theme="light"] .control-btn {
    background: rgba(15, 23, 42, 0.04);
    border: 1px solid rgba(15, 23, 42, 0.02);
  }

  .control-btn:hover {
    color: var(--text-primary);
    border-color: var(--accent);
    background: rgba(6, 182, 212, 0.1);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .control-icon {
    width: 15px;
    height: 15px;
  }

  /* Fullscreen Viewport styling */
  .sketch-viewport-container.is-fullscreen {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
    z-index: 9999 !important;
    background: #020408 !important;
    padding: 2rem !important;
    aspect-ratio: auto !important;
  }

  .sketch-viewport-container.is-fullscreen .sketch-canvas-wrapper {
    flex: 1;
    width: 100%;
    height: 100%;
  }

  /* Right Column: Statement Card */
  .statement-column {
    display: flex;
    flex-direction: column;
  }

  .statement-card {
    background: rgba(12, 18, 30, 0.45);
    border: 1px solid var(--glass-border);
    padding: 2.5rem;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition: var(--transition-smooth), var(--theme-transition);
  }

  html[data-theme="light"] .statement-card {
    background: rgba(255, 255, 255, 0.7);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.04);
  }

  .statement-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .meta-label {
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent-glow);
    transition: var(--theme-transition);
  }

  .project-title {
    font-size: 2.25rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    background: linear-gradient(135deg, var(--text-primary) 50%, var(--text-secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    transition: var(--theme-transition);
  }

  .artist-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .artist-label {
    font-size: 0.95rem;
    color: var(--text-muted);
    transition: var(--theme-transition);
  }

  .artist-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: var(--theme-transition);
  }

  .metadata-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    border-radius: 10px;
    padding: 1rem;
    transition: var(--theme-transition);
  }

  html[data-theme="light"] .metadata-grid {
    background: rgba(15, 23, 42, 0.02);
    border: 1px solid rgba(15, 23, 42, 0.04);
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .meta-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: var(--theme-transition);
  }

  .meta-value {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
    transition: var(--theme-transition);
  }

  .divider {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.08) 25%, rgba(255, 255, 255, 0.08) 75%, rgba(255, 255, 255, 0) 100%);
    margin: 2rem 0;
    transition: var(--theme-transition);
  }

  html[data-theme="light"] .divider {
    background: linear-gradient(90deg, rgba(15, 23, 42, 0) 0%, rgba(15, 23, 42, 0.08) 25%, rgba(15, 23, 42, 0.08) 75%, rgba(15, 23, 42, 0) 100%);
  }

  /* Markdown Content styling */
  .markdown-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .markdown-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .markdown-content :global(h2), 
  .markdown-content :global(h3), 
  .markdown-content :global(h4) {
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown-content :global(h3) {
    font-size: 1.4rem;
  }

  .markdown-content :global(strong) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .markdown-content :global(a) {
    border-bottom: 1px dashed var(--accent);
  }

  .markdown-content :global(a:hover) {
    border-bottom-style: solid;
    color: var(--text-primary);
  }

  /* Responsive Design */
  @media (max-width: 968px) {
    .project-layout-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .sketch-column {
      position: relative;
      top: 0;
    }

    .sketch-viewport-container {
      max-height: none;
    }

    .statement-card {
      padding: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .project-view-container {
      padding: 1rem 1rem 2rem 1rem;
    }

    .project-title {
      font-size: 1.75rem;
    }

    .sketch-viewport-container {
      padding: 1rem;
    }

    .control-btn span {
      display: none;
    }
  }
</style>
