---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Locale } from '../utils/translations';
import { SITE_CONFIG } from '../config';
import UnderConstruction from '../components/UnderConstruction.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// Determine current locale (fallback to 'es')
const locale = (Astro.currentLocale || 'es') as Locale;
const t = useTranslations(locale);

const pageTitle = title ? `${title} | ${t('site.title')}` : t('site.title');
const pageDescription = description || t('site.description');
const base = '/la-piscine';

// Maintenance Mode controls
const isMaintenance = SITE_CONFIG.maintenanceMode;
const pathname = Astro.url.pathname;
const normalizedPath = pathname.endsWith('/') ? pathname : `${pathname}/`;
const isSpanishHome = normalizedPath === `${base}/` || normalizedPath === '/' || normalizedPath === '/index.html' || normalizedPath === `${base}/index.html`;
const isEnglishHome = normalizedPath === `${base}/en/` || normalizedPath === '/en/' || normalizedPath === '/en/index.html' || normalizedPath === `${base}/en/index.html`;
const isHome = isSpanishHome || isEnglishHome;
const redirectUrl = locale === 'en' ? `${base}/en/` : `${base}/`;
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/png" href={`${base}/assets/favicon.png`} />

    <!-- Blocking script to initialize theme and prevent color flash -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light' || savedTheme === 'dark') {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          document.documentElement.setAttribute('data-theme', prefersLight ? 'light' : 'dark');
        }
      })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@200;300;400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style is:global>
      :root {
        /* Default Dark Mode (Nocturnal Pool theme) */
        --bg-primary: #05080e;
        --bg-secondary: #0c121e;
        --bg-tertiary: #131b2c;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        
        /* Neon Accents recalling "La Piscine" pool cyan & multimedia violet */
        --accent: #06b6d4; 
        --accent-hover: #0891b2;
        --accent-glow: rgba(6, 182, 212, 0.15);
        --accent-purple: #8b5cf6;
        --accent-purple-glow: rgba(139, 92, 246, 0.15);
        
        --glass-bg: rgba(12, 18, 30, 0.75);
        --glass-border: rgba(255, 255, 255, 0.05);
        --glass-border-hover: rgba(6, 182, 212, 0.25);
        
        --font-title: 'Outfit', sans-serif;
        --font-body: 'Inter', sans-serif;
        
        --transition-smooth: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        --theme-transition: background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                            color 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                            border-color 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                            box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      }

      html[data-theme="light"] {
        /* Premium Light Mode (Minimalist Art Gallery theme) */
        --bg-primary: #f8fafc;
        --bg-secondary: #ffffff;
        --bg-tertiary: #f1f5f9;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --text-muted: #94a3b8;
        
        --accent: #0284c7; 
        --accent-hover: #0369a1;
        --accent-glow: rgba(2, 132, 199, 0.1);
        --accent-purple: #7c3aed;
        --accent-purple-glow: rgba(124, 58, 237, 0.1);
        
        --glass-bg: rgba(255, 255, 255, 0.85);
        --glass-border: rgba(15, 23, 42, 0.08);
        --glass-border-hover: rgba(2, 132, 199, 0.3);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        background-color: var(--bg-primary);
        color: var(--text-primary);
        font-family: var(--font-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        overflow-x: hidden;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: var(--theme-transition);
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: var(--transition-smooth), var(--theme-transition);
      }

      a:hover {
        color: var(--text-primary);
      }

      h1, h2, h3, h4, h5, h6 {
        font-family: var(--font-title);
        font-weight: 500;
        letter-spacing: -0.02em;
        line-height: 1.2;
        transition: var(--theme-transition);
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--bg-primary);
        transition: var(--theme-transition);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--bg-tertiary);
        border-radius: 4px;
        border: 2px solid var(--bg-primary);
        transition: var(--theme-transition);
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
      }

      /* Container Utility */
      .container {
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      /* Glass Panel Utility */
      .glass-panel {
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 12px;
        transition: var(--transition-smooth), var(--theme-transition);
      }

      .glass-panel:hover {
        border-color: var(--glass-border-hover);
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4), 0 0 15px var(--accent-glow);
      }
    </style>
    <slot name="head" />

    {isMaintenance && !isHome && (
      <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
      <style is:inline>
        body { display: none !important; }
      </style>
      <script is:inline define:vars={{ redirectUrl }}>
        window.location.href = redirectUrl;
      </script>
    )}
  </head>
  <body>
    {isMaintenance && isHome ? (
      <UnderConstruction locale={locale} />
    ) : (
      <>
        <Header />
        <main style="flex: 1; display: flex; flex-direction: column;">
          <slot />
        </main>
        <Footer />
      </>
    )}
  </body>
</html>
